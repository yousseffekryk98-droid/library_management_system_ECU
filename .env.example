# ECU Library Management System
# Copy this file to .env.local for local development.
# Never commit real keys.

# Required: Supabase project URL
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Required: Supabase public/anon key
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional compatibility alias used by older deployments.
# If set, it takes precedence over VITE_SUPABASE_URL.
# VITE_SUPABASE_PROJECT_URL="https://YOUR_PROJECT.supabase.co"

# Optional server port. Defaults to 3000.
PORT=3000
